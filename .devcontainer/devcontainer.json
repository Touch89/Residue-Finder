{
  "name": "Residue Finder",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "VITE_API_URL": "/api"
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.34.3 --activate && pnpm install",
  "postStartCommand": "docker compose up -d --build",
  "forwardPorts": [8443, 8000],
  "portsAttributes": {
    "8443": { "label": "Sitio (Vite)", "onAutoForward": "openBrowser" },
    "8000": { "label": "API", "onAutoForward": "silent" },
    "3307": { "label": "MySQL", "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "bradlc.vscode-tailwindcss"]
    }
  }
}
